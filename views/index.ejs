<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudyOS</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col lg:flex-row">

  <!-- Sidebar: Courses & Navigation -->
  <aside class="w-full lg:w-80 bg-slate-900 border-b lg:border-r lg:border-b-0 border-slate-800 p-6 flex flex-col justify-between shrink-0">
    <div>
      <!-- Top Brand Header & Mobile Toggle -->
      <div class="flex items-center justify-between mb-6 lg:mb-8">
        <div class="flex items-center gap-3">
          <div class="bg-indigo-600 p-2 rounded-lg font-bold text-lg">SOS</div>
          <h1 class="text-xl font-bold tracking-wide">StudyOS</h1>
        </div>
        <!-- Mobile Hamburger Button -->
        <button id="mobile-menu-btn" class="lg:hidden text-slate-400 hover:text-white focus:outline-none p-2 rounded-lg bg-slate-800">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Collapsible Container for Mobile / Always Visible on Desktop -->
      <div id="sidebar-content" class="hidden lg:block">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">Your Courses</h2>
        
        <nav class="space-y-2 mb-8">
          <% if (courses && courses.length > 0) { %>
            <% courses.forEach(course => { %>
              <a href="/?courseId=<%= course.id %>" 
                 class="flex items-center justify-between p-3 rounded-lg transition <%= activeCourse && activeCourse.id === course.id ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800 text-slate-300' %>">
                <span class="font-medium"><%= course.code %></span>
                <span class="text-xs opacity-75 truncate max-w-[120px]"><%= course.name %></span>
              </a>
            <% }) %>
          <% } else { %>
            <p class="text-sm text-slate-500 italic">No courses added yet.</p>
          <% } %>
        </nav>

        <!-- Add Course Form -->
        <div class="bg-slate-950/50 p-4 rounded-xl border border-slate-800">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Add New Course</h3>
          <form action="/courses" method="POST" class="space-y-3">
            <input type="text" name="code" placeholder="Code (e.g. CS220)" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
            <input type="text" name="name" placeholder="Name (e.g. Discrete Math)" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 rounded-lg text-sm transition">Add Course</button>
          </form>
        </div>
      </div>
    </div>

    <div class="text-xs text-slate-500 text-center mt-6 hidden lg:block">
      StudyOS v1.0 &bull; MVC Architecture
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="flex-1 p-6 lg:p-10 overflow-y-auto">
    <% if (activeCourse) { %>
      <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 pb-6 border-b border-slate-800">
        <!-- Edit Course Form (Inline) -->
        <form action="/courses/<%= activeCourse.id %>/update" method="POST" class="flex items-center gap-3 w-full md:w-auto">
          <input type="text" name="code" value="<%= activeCourse.code %>" required class="w-24 bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm font-semibold uppercase text-indigo-400 focus:outline-none focus:border-indigo-500">
          <input type="text" name="name" value="<%= activeCourse.name %>" required class="w-full md:w-64 bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm font-bold text-slate-100 focus:outline-none focus:border-indigo-500">
          <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium px-3 py-2 rounded-lg transition whitespace-nowrap">Update</button>
        </form>

        <!-- Delete Course Button -->
        <form action="/courses/<%= activeCourse.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this course and all its lectures?');">
          <button type="submit" class="bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs font-medium px-3 py-2 rounded-lg transition">
            Delete Course
          </button>
        </form>
      </header>

      <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
        <!-- Left 2 Cols: Lectures List -->
        <div class="xl:col-span-2 space-y-6">
          <h3 class="text-lg font-semibold flex items-center gap-2">
            <span>Lecture Logs</span>
            <span class="text-xs bg-slate-800 px-2 py-0.5 rounded-full text-slate-400"><%= lectures.length %></span>
          </h3>

          <% if (lectures && lectures.length > 0) { %>
            <% lectures.forEach(lecture => { %>
              <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4">
                <div class="flex justify-between items-start">
                  <div>
                    <span class="text-xs text-indigo-400 font-medium"><%= lecture.date %></span>
                    <h4 class="text-xl font-semibold mt-0.5"><%= lecture.topic %></h4>
                  </div>
                  <div class="flex items-center gap-3">
                    <% if (lecture.covered) { %>
                      <span class="bg-emerald-500/10 text-emerald-400 text-xs px-2.5 py-1 rounded-full border border-emerald-500/20 font-medium">Covered: <%= lecture.covered %></span>
                    <% } %>
                    <!-- Delete Lecture Button -->
                    <form action="/courses/<%= activeCourse.id %>/lectures/<%= lecture.id %>/delete" method="POST" onsubmit="return confirm('Delete this lecture log?');">
                      <button type="submit" class="text-slate-500 hover:text-red-400 text-xs transition">&times; Delete</button>
                    </form>
                  </div>
                </div>

                <% if (lecture.notes && lecture.notes.length > 0) { %>
                  <div>
                    <h5 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Key Notes</h5>
                    <ul class="list-disc list-inside space-y-1 text-sm text-slate-300">
                      <% lecture.notes.forEach(note => { %>
                        <li><%= note %></li>
                      <% }) %>
                    </ul>
                  </div>
                <% } %>

                <% if (lecture.review && lecture.review.length > 0) { %>
                  <div class="pt-3 border-t border-slate-800/60">
                    <h5 class="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-2">Review / To-Do</h5>
                    <ul class="list-disc list-inside space-y-1 text-sm text-slate-300">
                      <% lecture.review.forEach(item => { %>
                        <li><%= item %></li>
                      <% }) %>
                    </ul>
                  </div>
                <% } %>

                <!-- Edit Lecture Form Accordion -->
                <details class="pt-3 border-t border-slate-800/60 group">
                  <summary class="text-xs font-medium text-indigo-400 cursor-pointer hover:underline">Edit this lecture</summary>
                  <form action="/courses/<%= activeCourse.id %>/lectures/<%= lecture.id %>/update" method="POST" class="space-y-3 mt-3 pt-3 border-t border-slate-800">
                    <div class="grid grid-cols-2 gap-3">
                      <input type="text" name="date" value="<%= lecture.date %>" required class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-indigo-500">
                      <input type="text" name="covered" value="<%= lecture.covered || '' %>" placeholder="Coverage" class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-indigo-500">
                    </div>
                    <input type="text" name="topic" value="<%= lecture.topic %>" required class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-indigo-500">
                    <textarea name="notes" rows="2" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-indigo-500 resize-none"><%= lecture.notes.join('\n') %></textarea>
                    <textarea name="review" rows="2" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-indigo-500 resize-none"><%= lecture.review.join('\n') %></textarea>
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition">Save Changes</button>
                  </form>
                </details>
              </div>
            <% }) %>
          <% } else { %>
            <div class="bg-slate-900/50 border border-slate-800/80 rounded-xl p-8 text-center text-slate-500">
              No lectures logged for this course yet. Use the form on the right to add your first entry!
            </div>
          <% } %>
        </div>

        <!-- Right Col: Add Lecture Form -->
        <div>
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 sticky top-10">
            <h3 class="text-base font-semibold mb-4">Log New Lecture</h3>
            <form action="/courses/<%= activeCourse.id %>/lectures" method="POST" class="space-y-4">
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Date</label>
                <input type="text" name="date" placeholder="e.g. Oct 24" required class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Topic</label>
                <input type="text" name="topic" placeholder="e.g. Matrix Multiplications" required class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Coverage / Sections</label>
                <input type="text" name="covered" placeholder="e.g. Chapter 3.2" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Key Notes (One per line)</label>
                <textarea name="notes" rows="3" placeholder="Point 1&#10;Point 2" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 resize-none"></textarea>
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Review Items (One per line)</label>
                <textarea name="review" rows="2" placeholder="Review theorem 4&#10;Practice problems" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 resize-none"></textarea>
              </div>

              <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 rounded-lg text-sm transition">Save Lecture</button>
            </form>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="h-full flex flex-col items-center justify-center text-center text-slate-500 space-y-3 py-20">
        <h2 class="text-2xl font-bold text-slate-300">Welcome to StudyOS</h2>
        <p class="max-w-md text-sm">Get started by opening the menu and creating your first course.</p>
      </div>
    <% } %>
  </main>

  <!-- Mobile Menu Toggle Script -->
  <script>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const sidebarContent = document.getElementById('sidebar-content');

    menuBtn.addEventListener('click', () => {
      sidebarContent.classList.toggle('hidden');
    });
  </script>
</body>
</html>